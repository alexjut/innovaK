Ref: actividad_indicador.actividad_plan_id > actividad_plan.id
Ref: actividad_indicador.indicador_id > presu_indicador_meta_proyecto.id
Ref: actividad_plan.actividad_id > actividad.id
Ref: actividad_plan.proyecto_id > proyecto.id
Ref: asistencia_clase.clase_id > clase.id
Ref: asistencia_clase.participante_id > participante.id
Ref: auditoria_pertenencia.actor_id > usuario.id
Ref: auditoria_pertenencia.group_id > auth_group.id
Ref: auditoria_pertenencia.usuario_objetivo_id > usuario.id
Ref: auth_group_permissions.permission_id > auth_permission.id
Ref: auth_group_permissions.group_id > auth_group.id
Ref: auth_permission.content_type_id > django_content_type.id
Ref: auth_user_groups.group_id > auth_group.id
Ref: auth_user_groups.user_id > auth_user.id
Ref: auth_user_user_permissions.permission_id > auth_permission.id
Ref: auth_user_user_permissions.user_id > auth_user.id
Ref: banco_enfoque_opcion.familia_codigo > banco_enfoque_familia.codigo
Ref: banco_evaluacion_inscripcion.evaluador_id > usuario.id
Ref: banco_evaluacion_inscripcion.inscripcion_id > inscripcion_banco_iniciativa.id
Ref: banco_evaluacion_inscripcion.rubrica_version > banco_rubrica.version
Ref: barrio.upz_codigo > upz.codigo
