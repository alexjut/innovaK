Ref: actividad_indicador.actividad_plan_id > actividad_plan.id
Ref: actividad_indicador.indicador_id > presu_indicador_meta_proyecto.id
Ref: actividad_plan.actividad_id > actividad.id
Ref: actividad_plan.proyecto_id > proyecto.id
Ref: barrio.upz_codigo > upz.codigo
Ref: barrio.upz_codigo > upz.codigo
Ref: beneficiario.organizacion_id > organizacion.id
Ref: beneficiario.persona_id > persona.id
Ref: beneficiario.proveedor_id > proveedor.id
Ref: captura_generica.evento_id > evento.id
Ref: caracterizacion_cultura.evento_id > evento.id
Ref: caracterizacion_cultura.funcionario_id > funcionario.id
Ref: caracterizacion_cultura.persona_id > persona.id
Ref: caracterizacion_deporte.evento_id > evento.id
Ref: caracterizacion_deporte.funcionario_id > funcionario.id
Ref: caracterizacion_deporte.lugar_incidencia_id > lugar_incidencia.id
Ref: caracterizacion_deporte.persona_id > persona.id
Ref: caracterizacion_mujer.evento_id > evento.id
Ref: caracterizacion_mujer.funcionario_id > funcionario.id
Ref: caracterizacion_mujer.informacion_hogar_id > informacion_hogar.id
Ref: caracterizacion_mujer.persona_id > persona.id
Ref: caracterizacion_participacion_ciudadana.evento_id > evento.id
Ref: caracterizacion_participacion_ciudadana.funcionario_id > funcionario.id
Ref: caracterizacion_participacion_ciudadana.persona_id > persona.id
Ref: caracterizacion_paz.evento_id > evento.id
Ref: caracterizacion_paz.persona_id > persona.id
Ref: caracterizacion_poblacional.evento_id > evento.id
Ref: caracterizacion_poblacional.funcionario_id > funcionario.id
Ref: caracterizacion_poblacional.persona_id > persona.id
Ref: caracterizacion_salud.evento_id > evento.id
Ref: caracterizacion_salud.funcionario_id > funcionario.id
Ref: caracterizacion_salud.persona_id > persona.id
Ref: caracterizacion_seguridad.evento_id > evento.id
Ref: caracterizacion_seguridad.persona_id > persona.id
Ref: cdp.proyecto_id > proyecto.id
Ref: contrato_actividad.actividad_id > actividad.id
Ref: contrato_actividad.contrato_id > contrato.id
Ref: contrato_beneficiario.beneficiario_id > beneficiario.id
Ref: contrato_beneficiario.contrato_id > contrato.id
Ref: contrato.cdp_id > cdp.id
Ref: contrato.funcionario > funcionario.id
Ref: contrato.proveedor_id > proveedor.id
Ref: contrato_proyecto.contrato_id > contrato.id
Ref: contrato_proyecto.proyecto_id > proyecto.id
Ref: documento_evento.evento_id > evento.id
Ref: documento_evento.tipo_archivo_id > tipo_archivo.id
Ref: entrega_beca_elemento.elemento_codigo > elemento_dotacion.codigo
Ref: entrega_beca_elemento.entrega_id > entrega_beca.id
Ref: entrega_insumo_colegio.colegio_sede_id > colegio_sede.id
Ref: entrega_insumo_colegio.contrato_id > contrato.id
Ref: entrega_insumo_elemento.entrega_id > entrega_insumo.id
Ref: entrega_insumo.evento_id > evento.id
Ref: entrega_insumo.persona_id > persona.id
Ref: escuela.barrio_codigo > barrio.codigo
Ref: escuela.localidad_codigo > localidad.codigo
