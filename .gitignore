# =====================================
# Python
# =====================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtualenvs
.venv/
venv/
ENV/
env/
env.bak/
pythonenv*

# Byte-compiled / optimized / DLL files
*.dll
*.dylib
*.exe
*.pyd

# =====================================
# Django
# =====================================
*.log
*.pot
*.pyc
*.sqlite3
db.sqlite3
debug.log

# Media y archivos de usuario
/media/
/uploads/
/temp/
/tmp/
/*.bak

# Outputs de collectstatic (docker-compose mapea static/ como STATIC_ROOT).
# La fuente canónica de estos assets vive en apps/<app>/static/<app>/.
/static/georeferenciacion/

# Archivos de migración (opcional, si no quieres versionarlas)
**/migrations/*.py
!**/migrations/__init__.py

# =====================================
# Docker
# =====================================
.docker/
.dockerignore
docker-compose.override.yml
.env
.env.local
.env.*.local
docker-compose.yml

# =====================================
# Node / Frontend
# =====================================
node_modules/
dist/
build/
.npm/
.yarn/
.pnp.*
package-lock.json
yarn.lock
# Etapa D Plan Frontend: el package-lock.json de frontend/ SÍ se commitea
# (build reproducible en CI). La regla genérica de arriba excluye otros.
!frontend/package-lock.json

# =====================================
# IDEs y herramientas
# =====================================
.vscode/
.idea/
*.iml

# =====================================
# Sistema
# =====================================
.DS_Store
Thumbs.db
desktop.ini

# =====================================
# Coverage / Testing
# =====================================
.coverage
.tox/
.nox/
.cache/
pytest_cache/
coverage.xml
htmlcov/

# =====================================
# Otros
# =====================================
*.swp
*.swo
*.orig

# =====================================
# Frontend Angular (Etapa D Plan Frontend)
# =====================================
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/
frontend/.cache/
frontend/npm-debug.log
frontend/.env
frontend/tmp/
frontend/openapi.yml
credenciales_georef.local.txt
