# =====================================
# Python
# =====================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtualenvs
.venv/
venv/
ENV/
env/
env.bak/
pythonenv*

# Byte-compiled / optimized / DLL files
*.dll
*.dylib
*.exe
*.pyd

# =====================================
# Django
# =====================================
*.log
*.pot
*.pyc
*.sqlite3
db.sqlite3
debug.log

# Media y archivos de usuario
/media/
/uploads/
/temp/
/tmp/
/*.bak

# Outputs de collectstatic (docker-compose mapea static/ como STATIC_ROOT).
# La fuente canónica de estos assets vive en apps/<app>/static/<app>/.
/static/georeferenciacion/

# STATIC_ROOT (settings.py). Es output de collectstatic, se regenera en deploy;
# el runtime real usa el mount de static/ (docker-compose), no esta carpeta.
/staticfiles/

# Archivos de migración (opcional, si no quieres versionarlas)
**/migrations/*.py
!**/migrations/__init__.py

# =====================================
# Docker
# =====================================
.docker/
# .dockerignore NO se ignora: es lo único que impide que `COPY . .` hornee el
# .env, el .git y el .claude dentro de la imagen. Debe viajar con el repo.
docker-compose.override.yml
.env
.env.local
.env.*.local
docker-compose.yml
# Excepción: la copia de referencia en docs/infra/ (solo ${VAR}, sin secretos)
# se versiona como documentación de despliegue.
!docs/infra/artefactos/docker-compose.yml

# =====================================
# Node / Frontend
# =====================================
node_modules/
dist/
build/
.npm/
.yarn/
.pnp.*
package-lock.json
yarn.lock
# Etapa D Plan Frontend: el package-lock.json de frontend/ SÍ se commitea
# (build reproducible en CI). La regla genérica de arriba excluye otros.
!frontend/package-lock.json

# =====================================
# IDEs y herramientas
# =====================================
.vscode/
.idea/
*.iml

# =====================================
# Sistema
# =====================================
.DS_Store
Thumbs.db
desktop.ini

# =====================================
# Coverage / Testing
# =====================================
.coverage
.tox/
.nox/
.cache/
pytest_cache/
coverage.xml
htmlcov/

# =====================================
# Secretos y archivos locales de operación (NUNCA a git)
# =====================================
# Rosters de usuarios/contraseñas temporales que genera el admin.
# El propio archivo declara "GITIGNORED · NO subir a git".
*.local.txt
credenciales_*.txt
# Control de usuarios: nombre + cédula + contrato CPS de personas reales. El
# repo es PÚBLICO y eso es habeas data (Ley 1581). El control se mantiene: los
# archivos siguen existiendo en la máquina del admin, solo no se versionan.
# Es la misma regla que `crear_usuarios_georef.py` ya enuncia para las claves.
*.local.md

# =====================================
# Worktrees efímeros de agentes (Claude Code)
# =====================================
.claude/worktrees/

# =====================================
# Otros
# =====================================
*.swp
*.swo
*.orig

# =====================================
# Frontend Angular (Etapa D Plan Frontend)
# =====================================
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/
frontend/.cache/
frontend/npm-debug.log
frontend/.env
frontend/tmp/
frontend/openapi.yml
credenciales_georef.local.txt
